#!/usr/bin/env python3
"""disk-audit — find what's taking up space and have Jev judge each item.

Scans ~/Library and dev caches/toolchains in your home folder, picks out the
biggest items, and asks Jev (TypeSafe's System One model) three things about
each one: can it be deleted, is it a duplicate, and has it gone unused. It never
deletes anything. It writes a report you can read (Markdown + JSON).

usage:
  disk-audit                    # scan + judge (needs JEV_API_KEY)
  disk-audit --dry-run          # scan only, Jev is not asked
  disk-audit --threshold-mb 1000 --roots ~/Library ~/.gradle

Jev is asked through .scripts/jev, next to this script, so the request is built
in one place. Without JEV_API_KEY nothing is sent and this exits 2, the same
"Jev was not asked" code jev uses; --dry-run scans without it.

Report goes to ~/Library/Logs/disk-audit/latest.md (and .json).
"""
import argparse
import datetime as dt
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor, as_completed

HOME = os.path.expanduser("~")
JEV = os.path.join(os.path.dirname(os.path.realpath(__file__)), "jev")
EXIT_NOT_ASKED = 2  # as in .scripts/jev
DEFAULT_ROOTS = [
    "Library",
    ".android", ".gradle", ".npm", ".cache", ".cocoapods", ".ollama",
    ".rustup", ".cargo", ".conda", ".gem", ".m2", ".yarn", ".bun", ".volta",
    ".expo", ".pnpm-state", ".platformio", ".swiftpm", ".asdf", ".rbenv",
    ".docker_old", ".diffusionbee", ".node", ".phpenv", ".opam", ".local",
    ".cursor", ".vscode", ".vscode-insiders", ".codex", ".gemini", "go",
]
# Cloud-backed or special folders the scan leaves alone.
SKIP = {
    os.path.join(HOME, "Library", p)
    for p in ("Mobile Documents", "CloudStorage", "Metadata", "Biome",
              "Trial", "Daemon Containers")
}

