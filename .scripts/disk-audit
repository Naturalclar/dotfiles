def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1024


def tilde(p):
    return "~" + p[len(HOME):] if p.startswith(HOME) else p


def ago(ts, now):
    if not ts:
        return "unknown"
    d = dt.datetime.fromtimestamp(ts)
    days = max(0, int((now - ts) // 86400))  # clock skew can put mtimes ahead
    return f"{d:%Y-%m-%d} ({days} days ago)"


class Node:
    __slots__ = ("path", "is_dir", "size", "mtime", "atime", "files", "children", "rest_of")

    def __init__(self, path, is_dir):
        self.path, self.is_dir = path, is_dir
        self.size = self.mtime = self.atime = self.files = 0
        self.children = []
        self.rest_of = 0


class Scanner:
    def __init__(self, max_depth, dup_min):
        self.max_depth, self.dup_min = max_depth, dup_min
        self.seen_inodes = set()
        self.big_files = []  # (size, path) for duplicate detection
        self.count = 0
        self.errors = 0

    def scan(self, path, depth=0):
        node = Node(path, True)
        try:
            it = os.scandir(path)
        except OSError:
            self.errors += 1
            return node
        with it:
            for e in it:
                p = e.path
                if p in SKIP:
                    continue
                try:
                    st = e.stat(follow_symlinks=False)
                except OSError:
                    self.errors += 1
                    continue
                if e.is_symlink():
                    continue
                if e.is_dir(follow_symlinks=False):
                    child = self.scan(p, depth + 1)
                else:
                    if st.st_nlink > 1:
                        key = (st.st_dev, st.st_ino)
                        if key in self.seen_inodes:
                            continue
                        self.seen_inodes.add(key)
                    child = Node(p, False)
                    child.size = st.st_blocks * 512
                    child.mtime, child.atime, child.files = st.st_mtime, st.st_atime, 1
                    if child.size >= self.dup_min and e.is_file(follow_symlinks=False):
                        self.big_files.append((st.st_size, p))
                    self.count += 1
                    if self.count % 200000 == 0:
                        print(f"  … {self.count:,} files scanned", file=sys.stderr)
                node.size += child.size
                node.files += child.files
                node.mtime = max(node.mtime, child.mtime)
                node.atime = max(node.atime, child.atime)
                if depth < self.max_depth:
                    node.children.append(child)
        return node


def find_duplicates(big_files):
    """Group identical large files: by size, then head+tail hash, then full hash."""
    by_size = {}
    seen = set()
    for size, p in big_files:
        # One path, one entry. Listed twice it becomes its own duplicate, and
        # the report claims that much space is redundant when none of it is.
        if p in seen:
            continue
        seen.add(p)
        by_size.setdefault(size, []).append(p)

    def quick(p):
        h = hashlib.sha256()
        with open(p, "rb") as f:
            h.update(f.read(1 << 20))
            f.seek(max(0, os.path.getsize(p) - (1 << 20)))
            h.update(f.read(1 << 20))
        return h.hexdigest()

    def full(p):
        h = hashlib.sha256()
        with open(p, "rb") as f:
            for chunk in iter(lambda: f.read(8 << 20), b""):
                h.update(chunk)
        return h.hexdigest()

    groups = []
    for size, paths in by_size.items():
        if len(paths) < 2:
            continue
        for hasher in (quick, full):
            buckets = {}
            for p in paths:
                try:
                    buckets.setdefault(hasher(p), []).append(p)
                except OSError:
                    pass
            paths = [p for b in buckets.values() if len(b) > 1 for p in b]
            if hasher is full:
                groups += [(size, sorted(b)) for b in buckets.values() if len(b) > 1]
            if not paths:
                break
    return groups


# Folders whose children are the natural unit to judge (one per project,
# OS version, emulator image, app…).
UNIT_CHILDREN = [
    "/Library/Developer/Xcode/DerivedData", "/Library/Developer/Xcode/iOS DeviceSupport",
    "/Library/Developer/Xcode/watchOS DeviceSupport", "/Library/Developer/Xcode/Archives",
    "/Library/Developer/CoreSimulator/Devices", "/Library/Developer/CoreSimulator/Volumes",
    "/Library/Android/sdk/system-images", "/Library/Android/sdk/ndk",
    "/Library/Android/sdk/build-tools", "/Library/Android/sdk/platforms",
    "/.android/avd", "/.gradle/wrapper/dists", "/.gradle/caches", "/.rustup/toolchains",
    "/Library/Caches", "/Library/Application Support", "/Library/Containers",
    "/Library/Group Containers", "/Library/Logs", "/.cache",
]
# Folders judged as one item.
UNIT_SELF = [
    "/.npm/_cacache", "/.cocoapods/repos", "/.cargo/registry", "/.conda/pkgs",
    "/.m2/repository", "/.yarn/berry/cache", "/.ollama/models/blobs",
]


def pick_candidates(root, threshold):
    """Items at or above the threshold, broken down to a useful unit."""
    out = []

    def rest(node, small):
        size = sum(c.size for c in small)
        if small and size >= threshold:
            r = Node(node.path, True)
            r.size, r.files = size, sum(c.files for c in small)
            r.mtime = max(c.mtime for c in small)
            r.atime = max(c.atime for c in small)
            r.rest_of = len(small)
            out.append((r, node))

    def walk(node, parent):
        p = node.path
        if node is not root and node.size >= threshold and any(p.endswith(u) for u in UNIT_SELF):
            out.append((node, parent))
            return
        big = [c for c in node.children if c.size >= threshold]
        if any(p.endswith(u) for u in UNIT_CHILDREN):
            # The scanner stops recording children at --max-depth but keeps
            # adding up their bytes, so a folder sitting exactly on the limit
            # arrives here with a real size and nothing to break it into.
            # Report the folder itself; returning empty-handed dropped it from
            # the table and from the totals, without a word either way.
            if not node.children:
                if node is not root and node.size >= threshold:
                    out.append((node, parent))
                return
            for c in big:
                out.append((c, node))
            rest(node, [c for c in node.children if c.size < threshold])
            return
        big_dirs = [c for c in big if c.is_dir]
        if node is not root and node.size >= threshold and not big_dirs:
            out.append((node, parent))
            return
        for c in big:
            if c.is_dir:
                walk(c, node)
            else:
                out.append((c, node))

    walk(root, None)
    return out


def ollama_models(root_dir):
    """Turn Ollama's content-addressed blobs into one item per model."""
    man_root = os.path.join(root_dir, "models", "manifests")
    blob_dir = os.path.join(root_dir, "models", "blobs")
    models = []
    for dirpath, _, files in os.walk(man_root):
        for fn in files:
            mp = os.path.join(dirpath, fn)
            try:
                with open(mp) as f:
                    m = json.load(f)
            except (OSError, ValueError):
                continue
            digests = [l.get("digest") for l in m.get("layers", [])]
            if m.get("config"):
                digests.append(m["config"].get("digest"))
            size, atime = 0, 0
            for d in filter(None, digests):
                bp = os.path.join(blob_dir, d.replace(":", "-"))
                try:
                    st = os.stat(bp)
                    size += st.st_blocks * 512
                    atime = max(atime, st.st_atime)
                except OSError:
                    pass
            rel = os.path.relpath(dirpath, man_root).split(os.sep)
            name = "/".join(rel[1:]) + ":" + fn if len(rel) > 1 else fn
            try:
                mtime = os.stat(mp).st_mtime
            except OSError:
                continue  # `ollama rm`/`pull` can take the manifest mid-scan
            n = Node(mp, False)
            n.size, n.mtime, n.atime, n.files = size, mtime, atime, len(digests)
            models.append((name.replace("library/", ""), n))
    return models


def call_jev(state, timeout, retries=3):
    """Ask Jev about one item via .scripts/jev. Returns its `answers` object."""
    cmd = [JEV, "--state-file", "-", "--questions", json.dumps(QUESTIONS),
           "--timeout", str(timeout)]
    for attempt in range(retries):
        r = subprocess.run(cmd, input=json.dumps(state, ensure_ascii=False),
                           capture_output=True, text=True)
        if r.returncode == 0:
            return json.loads(r.stdout)
        # Match against the whole of stderr, not one line of it: jev puts up to
        # 300 characters of the HTTP error body in its message, and a server's
        # body is usually multi-line HTML, so the status ended up on a line the
        # substring test never saw. A 503 then retried once instead of three
        # times, and the report showed the error as `</html>`.
        err_text = r.stderr.strip()
        err = err_text.splitlines()[0] if err_text else f"jev exited {r.returncode}"
        # Rate limits and server errors are worth another try; the rest are not.
        if attempt < retries - 1 and any(f"HTTP {c}" in err_text for c in (429, 500, 502, 503, 504)):
            time.sleep(2 ** attempt)
            continue
        raise RuntimeError(err)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--roots", nargs="+", help="folders to scan (default: ~/Library and dev caches)")
    ap.add_argument("--threshold-mb", type=int, default=500, help="smallest item to judge (default 500)")
    ap.add_argument("--dup-min-mb", type=int, default=50, help="smallest file checked for duplicates (default 50)")
    ap.add_argument("--max-depth", type=int, default=6, help="how deep to break folders down (default 6)")
    ap.add_argument("--jobs", type=int, default=8, help="parallel Jev requests (default 8)")
    ap.add_argument("--timeout", type=float, default=60, help="seconds to wait for each Jev answer (default 60)")
    ap.add_argument("--out", default=os.path.join(HOME, "Library", "Logs", "disk-audit"))
    ap.add_argument("--dry-run", action="store_true", help="scan only; don't call Jev")
    args = ap.parse_args()
    sys.setrecursionlimit(10000)

    # Check the numbers before scanning anything. `--threshold-mb 0` used to
    # reach an empty max() and `--jobs 0` an empty thread pool, both of them
    # only after the full scan and the duplicate hashing had been paid for.
    for name, value, least in (("--threshold-mb", args.threshold_mb, 1),
                               ("--dup-min-mb", args.dup_min_mb, 0),
                               ("--max-depth", args.max_depth, 1),
                               ("--jobs", args.jobs, 1)):
        if value < least:
            ap.error(f"{name} must be at least {least} (got {value})")
    if args.timeout <= 0:
        ap.error(f"--timeout must be greater than 0 (got {args.timeout})")

    if not args.dry_run and not os.environ.get("JEV_API_KEY"):
        print("disk-audit: JEV_API_KEY is not set, so Jev was not asked "
              "(use --dry-run to scan without it)", file=sys.stderr)
        return EXIT_NOT_ASKED

    roots = [os.path.abspath(os.path.expanduser(r)) for r in args.roots] if args.roots \
        else [os.path.join(HOME, r) for r in DEFAULT_ROOTS]

    # Say which roots are not being scanned and why. Dropping them quietly
    # produced an empty report and exit 0 for a typo'd path, which reads as
    # "nothing is using disk space" rather than "nothing was looked at".
    # Explicit --roots are worth a word each; the built-in defaults are not
    # expected to all exist on every machine.
    kept = []
    for r in roots:
        if os.path.islink(r):
            why = "a symlink"
        elif not os.path.isdir(r):
            why = "not a directory"
        else:
            kept.append(r)
            continue
        if args.roots:
            print(f"disk-audit: skipping {tilde(r)}: {why}", file=sys.stderr)

    # Overlapping roots scanned the same bytes twice: sizes were counted twice
    # and a file became its own duplicate, reported as "N MB redundant" with
    # the same path on both lines.
    roots = []
    for r in sorted(set(kept), key=len):
        if any(r == k or r.startswith(k + os.sep) for k in roots):
            print(f"disk-audit: skipping {tilde(r)}: already inside a scanned root",
                  file=sys.stderr)
            continue
        roots.append(r)

    if not roots:
        print("disk-audit: no directory to scan; nothing was examined", file=sys.stderr)
        return EXIT_NOT_ASKED
    threshold = args.threshold_mb << 20
    now = time.time()
    today = dt.date.today().isoformat()

    scanner = Scanner(args.max_depth, args.dup_min_mb << 20)
    root_sizes, items = [], []
    t0 = time.time()
    for r in roots:
        print(f"scanning {tilde(r)}", file=sys.stderr)
        node = scanner.scan(r)
        root_sizes.append((tilde(r), node.size))
        is_ollama = os.path.basename(r) == ".ollama"
        for cand, parent in pick_candidates(node, threshold):
            if is_ollama and "/models/blobs" in cand.path:
                continue
            items.append({"node": cand, "parent": parent, "kind": "directory" if cand.is_dir else "file"})
        if is_ollama:
            for name, n in ollama_models(r):
                if n.size >= threshold // 4:
                    items.append({"node": n, "parent": None, "kind": "ollama_model", "label": name})
    print(f"scanned {scanner.count:,} files in {time.time() - t0:.0f}s "
          f"({scanner.errors} unreadable)", file=sys.stderr)

    print("checking large files for duplicates", file=sys.stderr)
    dup_groups = find_duplicates(scanner.big_files)
    dup_of = {p: [q for q in g if q != p] for _, g in dup_groups for p in g}

    for it in items:
        n, parent = it["node"], it["parent"]
        path = n.path
        if it["kind"] == "ollama_model":
            label = f"Ollama model {it['label']}"
        elif n.rest_of:
            label = f"{tilde(path)} ({n.rest_of} smaller items, each under the threshold)"
        else:
            label = tilde(path)
        state = {
            "today": today,
            "path": label,
            "kind": it["kind"],
            "size": human(n.size),
            "file_count": n.files,
            "last_modified": ago(n.mtime, now),
            "last_accessed": ago(n.atime, now) + " (approximate on macOS)",
        }
        hint = next((h for k, h in HINTS if k in (path + "/")), None)
        if hint:
            state["context_hint"] = hint
        if parent is not None:
            sibs = sorted((c for c in parent.children if c is not n), key=lambda c: -c.size)[:25]
            if sibs:
                state["siblings"] = [f"{os.path.basename(c.path)} — {human(c.size)} — modified {ago(c.mtime, now)}" for c in sibs]
        if it["kind"] == "file" and path in dup_of:
            state["identical_copies_elsewhere"] = [tilde(q) for q in dup_of[path]]
        elif it["kind"] == "directory":
            inner = [(p, qs) for p, qs in dup_of.items() if p.startswith(path + "/")]
            outside = [(p, [q for q in qs if not q.startswith(path + "/")]) for p, qs in inner]
            outside = [(p, qs) for p, qs in outside if qs]
            if outside:
                state["identical_copies_elsewhere"] = [f"{tilde(p)} = {tilde(qs[0])}" for p, qs in outside[:10]]
        it.update(label=label, state=state, size=n.size, mtime=n.mtime)

    items.sort(key=lambda i: -i["size"])

    asked_jev = bool(not args.dry_run and items)
    if asked_jev:
        print(f"asking Jev about {len(items)} items", file=sys.stderr)
        with ThreadPoolExecutor(args.jobs) as pool:
            futs = {pool.submit(call_jev, it["state"], args.timeout): it for it in items}
            for i, f in enumerate(as_completed(futs), 1):
                it = futs[f]
                try:
                    it["jev"] = {"answers": f.result()}
                except Exception as e:  # keep going; report the failure per item
                    it["error"] = str(e)
                if i % 20 == 0:
                    print(f"  … {i}/{len(items)}", file=sys.stderr)

    # ---- write report ----
    os.makedirs(args.out, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    rows = []
    for it in items:
        a = (it.get("jev") or {}).get("answers", {})
        rows.append({
            "path": it["label"], "kind": it["kind"], "bytes": it["size"], "size": human(it["size"]),
            "last_modified": ago(it["mtime"], now),
            "action": a.get("action", {}).get("choice"),
            "action_confidence": a.get("action", {}).get("confidence"),
            "p_deletable": a.get("deletable", {}).get("noul"),
            "p_duplicate": a.get("duplicate", {}).get("noul"),
            "p_stale": a.get("stale", {}).get("noul"),
            "state_sent": it["state"], "jev_response": it.get("jev"), "error": it.get("error"),
        })
    report = {
        "generated": dt.datetime.now().isoformat(timespec="seconds"),
        # Whether Jev was actually asked, not merely whether it was allowed to
        # be: a scan that turned up no items calls nothing, and claiming
        # otherwise is the one thing the jev skill says never to do.
        "judged_by_jev": asked_jev,
        "threshold_mb": args.threshold_mb,
        "roots": [{"path": p, "bytes": s, "size": human(s)} for p, s in sorted(root_sizes, key=lambda x: -x[1])],
        "free_space": human(shutil.disk_usage(HOME).free),
        "items": rows,
        "duplicate_groups": [{"size": human(s), "wasted": human(s * (len(g) - 1)), "paths": [tilde(p) for p in g]}
                             for s, g in sorted(dup_groups, key=lambda x: -x[0] * (len(x[1]) - 1))],
    }

    def pct(x):
        return "–" if x is None else f"{x:.0%}"

    total = {k: sum(r["bytes"] for r in rows if r["action"] == k) for k in ("delete", "review", "keep")}
    md = [f"# Disk audit — {report['generated']}", "",
          f"Free space: **{report['free_space']}** · judged by Jev" if not args.dry_run else "Dry run: Jev was not asked", ""]
    if not args.dry_run:
        md += [f"- Jev says **delete**: {human(total['delete'])}",
               f"- Jev says **review**: {human(total['review'])}",
               f"- Jev says **keep**: {human(total['keep'])}", ""]
    md += ["## Scanned folders", "", "| Size | Folder |", "|---:|---|"]
    md += [f"| {r['size']} | `{r['path']}` |" for r in report["roots"] if r["bytes"] >= 1 << 20]
    md += ["", f"## Items ≥ {args.threshold_mb} MB", "",
           "| Action | Size | Path | Deletable | Duplicate | Stale | Last modified |", "|---|---:|---|---:|---:|---:|---|"]
    for r in rows:
        act = r["action"] or ("error" if r["error"] else "–")
        md.append(f"| {act} | {r['size']} | `{r['path']}` | {pct(r['p_deletable'])} | {pct(r['p_duplicate'])} | "
                  f"{pct(r['p_stale'])} | {r['last_modified']} |")
    if report["duplicate_groups"]:
        md += ["", "## Identical files", ""]
        for g in report["duplicate_groups"]:
            md.append(f"- {g['size']} each, {g['wasted']} redundant: " + ", ".join(f"`{p}`" for p in g["paths"]))
    errs = [r for r in rows if r["error"]]
    if errs:
        md += ["", "## Not judged by Jev", ""] + [f"- `{r['path']}`: {r['error']}" for r in errs[:20]]
    md += ["", "_Nothing was deleted. Ollama models can share layers, so their sizes can overlap._"]

    for name in (f"report-{stamp}", "latest"):
        with open(os.path.join(args.out, name + ".json"), "w") as f:
            json.dump(report, f, indent=2, ensure_ascii=False)
        with open(os.path.join(args.out, name + ".md"), "w") as f:
            f.write("\n".join(md) + "\n")
    print(f"\nreport: {tilde(os.path.join(args.out, 'latest.md'))}", file=sys.stderr)
    if errs and len(errs) == len(rows):
        print(f"disk-audit: Jev was not asked about any item ({errs[0]['error']})", file=sys.stderr)
        return EXIT_NOT_ASKED
    return 0


if __name__ == "__main__":
    sys.exit(main())
